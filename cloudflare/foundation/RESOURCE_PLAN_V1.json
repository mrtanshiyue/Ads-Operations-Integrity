{
  "version": 1,
  "status": "design-only",
  "location_hint": "apac",
  "production": {
    "d1": [
      {"name": "ads-ops-control-prod", "role": "control", "binding": "CONTROL_DB"},
      {"name": "ads-ops-store-01-prod", "role": "store", "binding": "STORE_DB_01"},
      {"name": "ads-ops-store-02-prod", "role": "store", "binding": "STORE_DB_02"},
      {"name": "ads-ops-store-03-prod", "role": "store", "binding": "STORE_DB_03"},
      {"name": "ads-ops-store-04-prod", "role": "store", "binding": "STORE_DB_04"}
    ],
    "r2": [
      {"name": "ads-ops-data-prod", "binding": "ADS_DATA"}
    ],
    "workers": [
      {"name": "ads-operations-web", "role": "web-and-api"},
      {"name": "ads-operations-sync", "role": "amazon-sync-and-workflows"}
    ]
  },
  "development": {
    "d1": [
      {"name": "ads-ops-control-dev", "role": "control", "binding": "CONTROL_DB"},
      {"name": "ads-ops-store-dev", "role": "store", "binding": "STORE_DB_01"}
    ],
    "r2": [
      {"name": "ads-ops-data-dev", "binding": "ADS_DATA"}
    ]
  },
  "notes": [
    "No Cloudflare resource is created by this file.",
    "Amazon credentials are Secrets Store bindings and are never represented here.",
    "Expand development to four store D1 databases only when useful and account capacity is confirmed."
  ]
}
