{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ads-operations-web",
  "main": "./web-entry.js",
  "compatibility_date": "2026-08-14",
  "preview_urls": false,
  "assets": {
    "directory": "../../dist-cloudflare-native",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "dev": {
      "name": "ads-operations-web-dev",
      "vars": {
        "APP_ENV": "development",
        "ACCESS_MODE": "off",
        "SYNC_TRIGGER_ENABLED": "false",
        "PHASE5_SINGLE_RUN_PERMIT_ID": "",
        "PHASE5_SINGLE_RUN_REPORT_DATE": "",
        "TEAM_DOMAIN": "https://tanshiyuesir.cloudflareaccess.com",
        "ACCESS_AUD": "37435e34dd56c73c5c8d64a9bac3319f27389d8a953379cdab2ccaa4965cdaee"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "ads-ops-control-dev",
          "database_id": "2093b94f-27d5-4a4c-ada1-ff14af5c8de2",
          "migrations_dir": "../foundation/migrations/control"
        },
        {
          "binding": "STORE_01_DB",
          "database_name": "ads-ops-store-dev",
          "database_id": "123b2a32-d78b-4de9-8318-08e35cefb008",
          "migrations_dir": "../foundation/migrations/store"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DATA_BUCKET",
          "bucket_name": "ads-ops-data-dev"
        }
      ],
      "workflows": [
        {
          "name": "ads-amazon-sync-dev",
          "binding": "AMAZON_SYNC_WORKFLOW",
          "class_name": "AmazonAdsSyncWorkflow",
          "script_name": "ads-operations-sync-dev"
        }
      ]
    },
    "production": {
      "name": "ads-operations-web-prod",
      "vars": {
        "APP_ENV": "production",
        "ACCESS_MODE": "enforce",
        "SYNC_TRIGGER_ENABLED": "false",
        "PHASE5_SINGLE_RUN_PERMIT_ID": "",
        "PHASE5_SINGLE_RUN_REPORT_DATE": "",
        "TEAM_DOMAIN": "https://REPLACE_ME.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE_ME"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "ads-ops-control-prod",
          "database_id": "REPLACE_PROD_CONTROL_D1_ID",
          "migrations_dir": "../foundation/migrations/control"
        },
        {
          "binding": "STORE_01_DB",
          "database_name": "ads-ops-store-01-prod",
          "database_id": "REPLACE_PROD_STORE_01_D1_ID",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_02_DB",
          "database_name": "ads-ops-store-02-prod",
          "database_id": "REPLACE_PROD_STORE_02_D1_ID",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_03_DB",
          "database_name": "ads-ops-store-03-prod",
          "database_id": "REPLACE_PROD_STORE_03_D1_ID",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_04_DB",
          "database_name": "ads-ops-store-04-prod",
          "database_id": "REPLACE_PROD_STORE_04_D1_ID",
          "migrations_dir": "../foundation/migrations/store"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DATA_BUCKET",
          "bucket_name": "ads-ops-data-prod"
        }
      ],
      "workflows": [
        {
          "name": "ads-amazon-sync-prod",
          "binding": "AMAZON_SYNC_WORKFLOW",
          "class_name": "AmazonAdsSyncWorkflow",
          "script_name": "ads-operations-sync-prod"
        }
      ]
    }
  }
}