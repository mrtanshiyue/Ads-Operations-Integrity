{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ads-operations-web",
  "main": "./web-entry.js",
  "compatibility_date": "2026-08-14",
  "preview_urls": false,
  "assets": {
    "directory": "../../dist-cloudflare-native",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "dev": {
      "name": "ads-operations-web-dev",
      "vars": {
        "APP_ENV": "development",
        "ACCESS_MODE": "off",
        "SYNC_TRIGGER_ENABLED": "false",
        "PHASE5_SINGLE_RUN_PERMIT_ID": "",
        "PHASE5_SINGLE_RUN_REPORT_DATE": "",
        "TEAM_DOMAIN": "https://tanshiyuesir.cloudflareaccess.com",
        "ACCESS_AUD": "37435e34dd56c73c5c8d64a9bac3319f27389d8a953379cdab2ccaa4965cdaee"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "ads-ops-control-dev",
          "database_id": "2093b94f-27d5-4a4c-ada1-ff14af5c8de2",
          "migrations_dir": "../foundation/migrations/control"
        },
        {
          "binding": "STORE_01_DB",
          "database_name": "ads-ops-store-dev",
          "database_id": "123b2a32-d78b-4de9-8318-08e35cefb008",
          "migrations_dir": "../foundation/migrations/store"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DATA_BUCKET",
          "bucket_name": "ads-ops-data-dev"
        }
      ],
      "workflows": [
        {
          "name": "ads-amazon-sync-dev",
          "binding": "AMAZON_SYNC_WORKFLOW",
          "class_name": "AmazonAdsSyncWorkflow",
          "script_name": "ads-operations-sync-dev"
        }
      ]
    },
    "production": {
      "name": "ads-operations-web-prod",
      "vars": {
        "APP_ENV": "production",
        "ACCESS_MODE": "enforce",
        "SYNC_TRIGGER_ENABLED": "false",
        "PHASE5_SINGLE_RUN_PERMIT_ID": "",
        "PHASE5_SINGLE_RUN_REPORT_DATE": "",
        "TEAM_DOMAIN": "https://tanshiyuesir.cloudflareaccess.com",
        "ACCESS_AUD": "4cb87cb838507ac2e774cff9fdb6f53c6bbd2bc2db1ab0d9a2d1e04a9e5b1da8"
      },
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "ads-ops-control-prod",
          "database_id": "2122248c-1fd4-4ccd-b611-9f9d2f3decbf",
          "migrations_dir": "../foundation/migrations/control"
        },
        {
          "binding": "STORE_01_DB",
          "database_name": "ads-ops-store-prod-01",
          "database_id": "2e53bbad-5680-431c-bcf7-68e89b231ea1",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_02_DB",
          "database_name": "ads-ops-store-prod-02",
          "database_id": "a5d8e5b0-8d29-48a7-b200-6aa14a2fb997",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_03_DB",
          "database_name": "ads-ops-store-prod-03",
          "database_id": "d47867d7-f5ca-4ddc-a4af-87bf14325e22",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_04_DB",
          "database_name": "ads-ops-store-prod-04",
          "database_id": "c38ac43e-e62d-4387-b84d-2d080ce9a00b",
          "migrations_dir": "../foundation/migrations/store"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DATA_BUCKET",
          "bucket_name": "ads-ops-data-prod"
        }
      ],
      "workflows": [
        {
          "name": "ads-amazon-sync-prod",
          "binding": "AMAZON_SYNC_WORKFLOW",
          "class_name": "AmazonAdsSyncWorkflow",
          "script_name": "ads-operations-sync-prod"
        }
      ]
    }
  }
}