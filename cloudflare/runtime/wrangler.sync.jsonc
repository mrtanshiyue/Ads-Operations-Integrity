{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ads-operations-sync",
  "main": "./sync-worker.js",
  "compatibility_date": "2026-08-14",
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "env": {
    "dev": {
      "name": "ads-operations-sync-dev",
      "vars": {
        "APP_ENV": "development",
        "AMAZON_ADS_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "ads-ops-control-dev",
          "database_id": "2093b94f-27d5-4a4c-ada1-ff14af5c8de2",
          "migrations_dir": "../foundation/migrations/control"
        },
        {
          "binding": "STORE_01_DB",
          "database_name": "ads-ops-store-dev",
          "database_id": "123b2a32-d78b-4de9-8318-08e35cefb008",
          "migrations_dir": "../foundation/migrations/store"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DATA_BUCKET",
          "bucket_name": "ads-ops-data-dev"
        }
      ],
      "workflows": [
        {
          "name": "ads-amazon-sync-dev",
          "binding": "AMAZON_SYNC_WORKFLOW",
          "class_name": "AmazonAdsSyncWorkflow"
        }
      ]
    },
    "production": {
      "name": "ads-operations-sync-prod",
      "vars": {
        "APP_ENV": "production",
        "AMAZON_ADS_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "ads-ops-control-prod",
          "database_id": "REPLACE_PROD_CONTROL_D1_ID",
          "migrations_dir": "../foundation/migrations/control"
        },
        {
          "binding": "STORE_01_DB",
          "database_name": "ads-ops-store-01-prod",
          "database_id": "REPLACE_PROD_STORE_01_D1_ID",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_02_DB",
          "database_name": "ads-ops-store-02-prod",
          "database_id": "REPLACE_PROD_STORE_02_D1_ID",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_03_DB",
          "database_name": "ads-ops-store-03-prod",
          "database_id": "REPLACE_PROD_STORE_03_D1_ID",
          "migrations_dir": "../foundation/migrations/store"
        },
        {
          "binding": "STORE_04_DB",
          "database_name": "ads-ops-store-04-prod",
          "database_id": "REPLACE_PROD_STORE_04_D1_ID",
          "migrations_dir": "../foundation/migrations/store"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DATA_BUCKET",
          "bucket_name": "ads-ops-data-prod"
        }
      ],
      "workflows": [
        {
          "name": "ads-amazon-sync-prod",
          "binding": "AMAZON_SYNC_WORKFLOW",
          "class_name": "AmazonAdsSyncWorkflow"
        }
      ]
    }
  }
}
